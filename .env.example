# Reads Engine Gateway -- environment configuration reference (Director v0.7, Part O).
#
# Names and PLACEHOLDER values only. Never commit a real .env file -- this
# repo's .gitignore excludes .env / .env.* (with .env.example explicitly
# re-included so this reference file itself stays in version control).
#
# Copy this to .env locally (or set these as real environment variables /
# platform secrets in staging) and fill in real values there, never here.

# --- Required -----------------------------------------------------------

# Admin bearer token gating POST /v1/games/preview, POST /v1/games/generate,
# and GET /v1/games/{package_id}. Generate a real one with, e.g.:
#   openssl rand -hex 32
# Minimum 32 characters enforced at startup (gateway/config.py); a shorter
# or obviously-placeholder value logs a startup warning (not fatal, but
# should be fixed before real staging use). NEVER put this value in any
# browser-side JavaScript -- see READS_ENGINE_GATEWAY_V01_REPORT.md and
# READS_ENGINE_STAGING_V01_REPORT.md for why.
READS_ENGINE_ADMIN_TOKEN=changeme-generate-a-real-random-token

# Directory containing the Football Warehouse -- BOTH the Engine's own
# Python modules (game_factory.py etc.) AND reads_football_v4.0.sqlite,
# side by side (game_factory.py resolves its DB file relative to its own
# location on disk, not via any env var -- see
# tools/quiz_export/engine.py's docstring for the full reasoning). In
# staging this should point at a mounted persistent volume, never at
# ephemeral container storage.
READS_ENGINE_DIR=/path/to/Reads_Football_Data_Engine_v4.0

# --- Recommended for staging (sensible local defaults if unset) ----------

# Comma-separated list of exact origins allowed to make cross-origin
# requests. NEVER "*". If unset, defaults to gateway/config.py's
# DEFAULT_CORS_ORIGINS: the local dev origins below PLUS
# https://reads.football (v1.2 explicitly authorized and enabled this --
# the READS_ENGINE_PUBLIC_EXPOSURE_GATE.md this comment used to cite does
# not exist anywhere in this repo; not re-citing it). Only set this
# explicitly if a real deployment's actual origin set needs to differ from
# that default (e.g. www.reads.football, if that's ever confirmed to be a
# real separate serving origin rather than a redirect -- not assumed, v1.4).
READS_ENGINE_ALLOWED_ORIGINS=http://localhost:8934,http://127.0.0.1:8934

# Where the Gateway persists generated GeneratedGamePackage JSON files.
# Defaults to gateway/storage/packages/ (fine for local dev). In staging,
# point this at a mounted persistent volume path so packages survive a
# container restart -- see Part D/S of READS_ENGINE_STAGING_V01_REPORT.md.
READS_ENGINE_PACKAGES_DIR=/data/packages

# Where the Gateway persists Coach Connections v2's mutable per-game
# progress (gateway/services/game_state.py) -- deliberately a SEPARATE
# directory from READS_ENGINE_PACKAGES_DIR above, since packages.py is
# content-addressed/immutable and game_state.py is not. Defaults to
# gateway/storage/game_state/ (fine for local dev); point at the same
# mounted persistent volume as READS_ENGINE_PACKAGES_DIR in staging/prod.
READS_ENGINE_GAME_STATE_DIR=/data/game_state

# Where the Gateway writes its own local JSONL logs (gateway_audit_log.jsonl,
# gateway_operational_log.jsonl). Defaults to gateway/storage/. In staging,
# point this at persistent storage if log retention across restarts matters
# to you; the Gateway itself has no built-in rotation or shipping (Part M).
READS_ENGINE_LOG_DIR=/data/logs

# --- Optional -------------------------------------------------------------

# Requests-per-60-seconds caps (Part G). Defaults shown -- override only if
# you have a concrete reason to raise or lower them for a specific staging
# environment's expected traffic.
READS_ENGINE_PREVIEW_RATE_LIMIT=30
READS_ENGINE_GENERATE_RATE_LIMIT=10

# Public gameplay rate limits (v1.2/v1.3, Part 17/22). Defaults shown --
# deliberately more generous than the admin limits above (real end-user
# gameplay traffic, not internal tooling); chosen to tolerate a shared-NAT
# household with a few simultaneous players, not just one.
READS_ENGINE_PUBLIC_GAME_RATE_LIMIT=20
READS_ENGINE_PUBLIC_ANSWER_RATE_LIMIT=60

# Coach Connections v2 rate limits -- separate tiers because move
# submission is now free-text/open-ended (many more real candidate moves
# per node than the old fixed 4-option list) and autocomplete search is a
# new request shape fired roughly once per keystroke.
READS_ENGINE_COACH_CONNECTIONS_GAME_RATE_LIMIT=20
READS_ENGINE_COACH_CONNECTIONS_MOVE_RATE_LIMIT=120
READS_ENGINE_COACH_CONNECTIONS_SEARCH_RATE_LIMIT=90

# --- Production rollout controls (v1.4, Part 10/11/42) --------------------
# Not secrets -- safe to set directly in a platform's [env] block (see
# gateway/fly.toml) rather than through a secrets manager, though nothing
# breaks if you do.

# Master public-gameplay kill switch. "true" (the default if unset) means
# every code-certified mode CAN be served, matching how this has always
# behaved in every environment this project has tested in. Set to "false"
# for an instant, code-change-free, redeploy-free emergency shutdown of
# ALL public gameplay (GET /v1/public/game, POST /v1/public/game/answer) --
# admin routes are entirely unaffected either way. This is an OPERATIONAL
# switch, not the primary "should real users see this feature" gate --
# that gate is the FRONTEND's own feature flags (reads-config.js,
# ENABLE_ENGINE_DRAFT_PILOT_V01 / ENABLE_ENGINE_CHAMPIONSHIP_PILOT_V01,
# both default OFF there, Part 42).
READS_PUBLIC_GAME_ENABLED=true

# Comma-separated subset of the code-certified public modes
# (draft_guess, championship_guess) to currently allow -- can only ever
# NARROW what's certified in gateway/services/public_game.py, never expand
# it (an unrecognized mode name here is silently ignored, never granted).
# Unset (the default) means "every code-certified mode". Useful for a
# staged per-mode rollout without a code change -- e.g. set this to just
# "draft_guess" to launch Draft ahead of Championship. See
# READS_ENGINE_V14_IMPLEMENTATION_REPORT.md's canary rollout plan.
READS_PUBLIC_MODES=

# Real LLM provider credential -- NOT required for this milestone or any
# prior one. If unset (the default in every environment this project has
# ever run in), the translator layer reports REAL_PROVIDER_NOT_CONFIGURED
# rather than faking a real-LLM result -- see GAME_DIRECTOR_V02_REPORT.md
# and GAME_DIRECTOR_V03_REPORT.md, Part K. Never give this credential (or
# any LLM provider) database or tool access -- see
# tools/director_v02/providers/anthropic_provider.py.
ANTHROPIC_API_KEY=
